generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Account {
  id             Int      @id @default(autoincrement())
  name           String
  xHandle        String   @unique
  bio            String
  niche          String[]
  followersRange String
  email          String
  paid           Boolean  @default(false)
  status         String   @default("pending_payment")
  paymentId      String?
  createdAt      DateTime @default(now())
  avatarUrl      String?
  isClaimed      Boolean  @default(false)
  referredBy     String?
  userStatuses   UserAccountStatus[]
}

model UserAccountStatus {
  id        Int      @id @default(autoincrement())
  userId    String
  accountId Int
  status    String
  createdAt DateTime @default(now())
  account   Account  @relation(fields: [accountId], references: [id])

  @@unique([userId, accountId])
}

model OtpToken {
  id        String   @id @default(cuid())
  email     String
  code      String
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
}

model ReferralPayout {
  id          String   @id @default(cuid())
  promoterId  Int
  amount      Float
  note        String?
  createdAt   DateTime @default(now())

  promoter    Promoter @relation(fields: [promoterId], references: [id], onDelete: Cascade)
}

model Promoter {
  id               Int      @id @default(autoincrement())
  email            String   @unique
  name             String
  xHandle          String?
  username         String?  @unique
  referralCode     String   @unique
  payoutMethod     String?
  payoutDetails    String?
  totalEarned      Float    @default(0)
  pendingPayout    Float    @default(0)
  totalPaid        Float    @default(0)
  totalClicks      Int      @default(0)
  totalConversions Int      @default(0)
  createdAt        DateTime @default(now())
  Referral         Referral[]
  payouts          ReferralPayout[]
}

model Referral {
  id            Int       @id @default(autoincrement())
  referralCode  String
  promoterEmail String
  convertedAt   DateTime?
  amountEarned  Float?
  paymentId     String?
  status        String    @default("clicked")
  createdAt     DateTime  @default(now())
  Promoter      Promoter? @relation(fields: [promoterEmail], references: [email])
}
