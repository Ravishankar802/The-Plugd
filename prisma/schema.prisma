generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Account {
  id             Int      @id @default(autoincrement())
  name           String
  xHandle        String   @unique
  avatarPath     String?  // Store path to uploaded image
  bio            String
  niche          String
  followersRange String   // e.g. "1K - 5K"
  email          String
  paid           Boolean  @default(false)
  paymentId      String?
  createdAt      DateTime @default(now())
}
