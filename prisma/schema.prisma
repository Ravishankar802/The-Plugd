generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Account {
  id             Int      @id @default(autoincrement())
  name           String
  xHandle        String   @unique
  bio            String
  niche          String[]
  followersRange String
  email          String
  paid           Boolean  @default(false)
  status         String   @default("pending_payment")
  paymentId      String?
  createdAt      DateTime @default(now())
  avatarUrl      String?
  isClaimed      Boolean  @default(false)
  referredBy     String?
  userStatuses   UserAccountStatus[]
  referral       Referral?
}

model UserAccountStatus {
  id        Int      @id @default(autoincrement())
  userId    String
  accountId Int
  status    String
  createdAt DateTime @default(now())
  account   Account  @relation(fields: [accountId], references: [id])

  @@unique([userId, accountId])
}

model OtpToken {
  id        String   @id @default(cuid())
  email     String
  code      String
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
}

model AffiliateProgram {
  id               Int     @id @default(autoincrement())
  startupId        Int     @unique
  totalClicks      Int     @default(0)
  totalConversions Int     @default(0)
  totalPaid        Float   @default(0)
  active           Boolean @default(true)
  Startup          Startup @relation(fields: [startupId], references: [id])
}

model Conversion {
  id               Int      @id @default(autoincrement())
  promoterId       Int
  startupId        Int
  referralCode     String
  saleAmount       Float
  commissionEarned Float
  status           String   @default("pending")
  paymentRef       String?
  convertedAt      DateTime @default(now())
  Promoter         Promoter @relation(fields: [promoterId], references: [id])
  Startup          Startup  @relation(fields: [startupId], references: [id])
}

model Promoter {
  id                Int                 @id @default(autoincrement())
  email             String              @unique
  name              String
  xHandle           String?
  referralCode      String              @unique
  totalEarned       Float               @default(0)
  pendingPayout     Float               @default(0)
  totalClicks       Int                 @default(0)
  totalConversions  Int                 @default(0)
  payoutEmail       String?
  createdAt         DateTime            @default(now())
  Conversion        Conversion[]
  WithdrawalRequest WithdrawalRequest[]
  Referral          Referral[]
}

model Startup {
  id               Int               @id @default(autoincrement())
  name             String
  websiteUrl       String
  email            String            @unique
  description      String
  logoUrl          String?
  commissionPct    Float             @default(10)
  balance          Float             @default(0)
  postbackSecret   String            @unique
  status           String            @default("pending")
  createdAt        DateTime          @default(now())
  AffiliateProgram AffiliateProgram?
  Conversion       Conversion[]
}

model WithdrawalRequest {
  id            Int       @id @default(autoincrement())
  promoterId    Int
  amount        Float
  payoutMethod  String
  payoutDetails String
  status        String    @default("pending")
  requestedAt   DateTime  @default(now())
  paidAt        DateTime?
  Promoter      Promoter  @relation(fields: [promoterId], references: [id])
}
model Referral {
  id           Int      @id @default(autoincrement())
  promoterId   Int
  accountId    Int      @unique
  referralCode String
  amount       Float    @default(1.0)
  createdAt    DateTime @default(now())
  Promoter     Promoter @relation(fields: [promoterId], references: [id])
  Account      Account  @relation(fields: [accountId], references: [id])
}
