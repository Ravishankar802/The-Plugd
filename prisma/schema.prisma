generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Account {
  id             Int      @id @default(autoincrement())
  name           String
  xHandle        String   @unique
  avatarUrl      String?  // Store X profile picture URL
  bio            String
  niche          String[] // Store multiple niches
  followersRange String   // e.g. "1K - 5K"
  email          String
  paid           Boolean  @default(false)
  status         String   @default("pending_payment")
  paymentId      String?
  createdAt      DateTime @default(now())
}
