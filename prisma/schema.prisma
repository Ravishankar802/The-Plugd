generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Account {
  id             Int      @id @default(autoincrement())
  name           String
  xHandle        String   @unique
  avatarUrl      String?  // Store X profile picture URL
  bio            String
  niche          String[] // Store multiple niches
  followersRange String   // e.g. "1K - 5K"
  email          String
  paid           Boolean  @default(false)
  status         String   @default("pending_payment")
  paymentId      String?
  isClaimed      Boolean  @default(false)
  createdAt      DateTime @default(now())
}

model UserAccountStatus {
  id        Int      @id @default(autoincrement())
  userId    String   // Store email of the logged-in user
  accountId Int
  status    String   // 'followed', 'saved', 'not_interested'
  createdAt DateTime @default(now())

  @@unique([userId, accountId])
}
model OtpToken {
  id        String   @id @default(cuid())
  email     String
  code      String
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
}
